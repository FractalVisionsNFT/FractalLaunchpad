# =============================================================================
# Fractal Launchpad — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control. It is already in .gitignore.
# =============================================================================


# =============================================================================
# SIGNING (encrypted keystore — no plain-text private key needed)
# =============================================================================
# Import your deployer key once with:
#   cast wallet import <KEYSTORE_ACCOUNT> --interactive
#
# Then pass --account <KEYSTORE_ACCOUNT> --sender <DEPLOYER_ADDRESS> to forge.

KEYSTORE_ACCOUNT=fractal-deployer          # Name you gave the keystore on import
DEPLOYER_ADDRESS=0x                        # Public address of the deployer wallet


# =============================================================================
# LAUNCHPAD CONFIG
# =============================================================================
FEE_RECIPIENT=0x                           # Address that receives platform fees
PLATFORM_FEE=10000000000000000             # Fee in wei (default: 0.01 ETH = 10000000000000000)


# =============================================================================
# CREATE2 DEPLOYMENT
# =============================================================================
# The salt determines the deterministic address of each implementation contract.
# Use the SAME salt on every chain to get the same addresses everywhere.
# NEVER change it after the first deployment — a different salt = different addresses.
# Version number — increment on every new deployment (1, 2, 3 ...)
DEPLOY_VERSION=1


# Address of the already-deployed FractalLaunchpad (used by DeployImplementations.s.sol
# to call updateERC721Implementation / updateERC1155Implementation).
# Leave as zero-address if running SKIP_UPDATE=true (e.g. first deploy on a new chain).
LAUNCHPAD_ADDRESS=0x7A10b7d6Dc513Ae5F98f2C1546269Be9DE94ebD3

# Set to true to deploy implementations WITHOUT updating the Launchpad.
# Useful when deploying to a new chain before the Launchpad is live there.
SKIP_UPDATE=false


# =============================================================================
# RPC ENDPOINTS
# =============================================================================
# Replace the Alchemy API key (RtKWd-...) with your own.

BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>
BASE_MAINNET_RPC_URL=https://base-mainnet.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>
OPTIMISM_SEPOLIA_RPC_URL=https://opt-sepolia.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>
OP_MAINNET_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>


# =============================================================================
# BLOCK EXPLORER API KEYS (for --verify)
# =============================================================================
BASESCAN_API_KEY=<YOUR_BASESCAN_API_KEY>   # https://basescan.org/myapikey
ETHERSCAN_API_KEY=<YOUR_ETHERSCAN_API_KEY> # https://etherscan.io/myapikey (if needed)
